# Template for server/.env.production — the VPS's only secret file.
#
# Copy it into place on the server, never into git:
#   cp deploy/env.production.example server/.env.production
#
# The root .gitignore already ignores `.env.*`, which is why this template is
# named without a leading dot — otherwise it would be ignored too and would
# never reach the machine that needs it.
#
# Both containers read this one file. Postgres uses the POSTGRES_* variables;
# the API ignores those and uses the rest. One file, one place to get wrong.

# ---------------------------------------------------------------------------
# Postgres container
# ---------------------------------------------------------------------------
# Generate the password with:  openssl rand -hex 24
# Use hex, not base64: this value is embedded in DATABASE_URL below, and "+"
# or "/" in a connection string has to be percent-encoded or authentication
# fails with a message that blames the credentials rather than the encoding.
POSTGRES_USER=booking
POSTGRES_PASSWORD=REPLACE_WITH_openssl_rand_hex_24
POSTGRES_DB=booking

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
NODE_ENV=production
PORT=4000
LOG_LEVEL=info

# Host is the compose service name, not localhost: the API talks to Postgres
# over the compose network, not through the published 127.0.0.1:5434 mapping.
# The password here MUST equal POSTGRES_PASSWORD above.
DATABASE_URL="postgresql://booking:REPLACE_WITH_openssl_rand_hex_24@postgres:5432/booking?schema=public"

# prisma/schema.prisma declares shadowDatabaseUrl, so Prisma wants the variable
# to exist. `migrate deploy` never connects to it — it replays committed
# migrations and needs no diffing workspace. Leave this pointing at a database
# that does not exist; it is only here to satisfy schema loading.
SHADOW_DATABASE_URL="postgresql://booking:REPLACE_WITH_openssl_rand_hex_24@postgres:5432/booking_shadow?schema=public"

# ---------------------------------------------------------------------------
# URLs — these bake into canonicals, JSON-LD, sitemap and Stripe return URLs
# ---------------------------------------------------------------------------
# PUBLIC_URL serves the marketing site and studio booking pages.
# APP_URL serves the dashboard SPA.
# Change both if your hostnames differ.
PUBLIC_URL="https://artweel.fillforge.cloud"
APP_URL="https://app.artweel.fillforge.cloud"

# ---------------------------------------------------------------------------
# Auth — generate each with: openssl rand -base64 48
# ---------------------------------------------------------------------------
# The two MUST differ. One secret for both means a leaked access token can be
# replayed as a refresh token.
JWT_ACCESS_SECRET="REPLACE_WITH_openssl_rand_base64_48"
JWT_REFRESH_SECRET="REPLACE_WITH_A_DIFFERENT_openssl_rand_base64_48"

ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
EMAIL_VERIFY_TTL_HOURS=48
PASSWORD_RESET_TTL_MINUTES=60

# Do not lower this in production. 16 is ~67MB and ~150ms per hash by design.
PASSWORD_COST_EXPONENT=16

# ---------------------------------------------------------------------------
# Credential encryption — openssl rand -base64 32 (must decode to 32 bytes)
# ---------------------------------------------------------------------------
# Encrypts Google Calendar refresh tokens at rest. The app REFUSES TO BOOT in
# production without it, because the development fallback derives a key from
# JWT_ACCESS_SECRET — which would mean one leaked secret decrypts every
# studio's calendar credentials.
CREDENTIAL_ENCRYPTION_KEY="REPLACE_WITH_openssl_rand_base64_32"

# ---------------------------------------------------------------------------
# Booking behaviour
# ---------------------------------------------------------------------------
BOOKING_HOLD_TTL_MINUTES=10

# ---------------------------------------------------------------------------
# Stripe — REQUIRED in production, the app exits at startup without both
# ---------------------------------------------------------------------------
# Test-mode keys (sk_test_... / whsec_...) satisfy the check and are the right
# choice until the Connect platform application clears. Nothing charges real
# money in test mode.
STRIPE_SECRET_KEY="sk_test_REPLACE"
STRIPE_WEBHOOK_SECRET="whsec_REPLACE"
STRIPE_ACCOUNT_COUNTRY=US

# ---------------------------------------------------------------------------
# Email — blank means messages are logged instead of sent
# ---------------------------------------------------------------------------
RESEND_API_KEY=""
EMAIL_FROM="bookings@artweel.fillforge.cloud"

# ---------------------------------------------------------------------------
# SMS — blank means messages are logged instead of sent
# ---------------------------------------------------------------------------
# Leave blank until A2P 10DLC is approved. Configured-but-unregistered is the
# worst state: carriers filter the messages, so they look sent and never land.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# ---------------------------------------------------------------------------
# Reminders and TCPA quiet hours (studio-local time)
# ---------------------------------------------------------------------------
REMINDER_HOURS_AHEAD=24
SECOND_REMINDER_HOURS_AHEAD=2
SMS_QUIET_START_HOUR=8
SMS_QUIET_END_HOUR=21
NOTIFICATION_MAX_ATTEMPTS=6
NOTIFICATION_LEASE_SECONDS=120

# ---------------------------------------------------------------------------
# Google Calendar — blank uses the in-memory fake provider
# ---------------------------------------------------------------------------
# Redirect URI to register in Google Cloud console:
#   {PUBLIC_URL}/api/calendar/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
