// ---------------------------------------------------------------------------
// Booking SaaS — Phase 0 core domain
//
// Design rules that apply to EVERY model in this file:
//
//  1. organization_id on every tenant-owned table. Uniqueness is always
//     composite with it. The WordPress plugin this replaces had global
//     uniques (categories.name, staff.email) — those break the instant a
//     second tenant exists.
//
//  2. All instants are timestamptz. Never DATE + TIME. Alongside the instant
//     we keep the IANA timezone and the local wall-clock intent, so a weekly
//     7pm class stays at 7pm across a daylight-saving transition instead of
//     silently drifting an hour.
//
//  3. Money is integer cents. Never a float.
//
//  4. Correctness that matters is enforced by Postgres, not by application
//     code. The EXCLUDE constraints and CHECK constraints live in the
//     migration SQL — see migrations/*/migration.sql. Prisma cannot express
//     them, which is a limitation of Prisma, not a reason to skip them.
// ---------------------------------------------------------------------------

generator client {
  provider        = "prisma-client-js"
  // Required for the `extensions` block below — postgis and btree_gist are
  // not optional here, the concurrency model is built on them.
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
  extensions        = [postgis, btree_gist]
}

// ===========================================================================
// TENANCY & IDENTITY
// ===========================================================================

enum Plan {
  SOLO
  STUDIO
  PRO
}

enum SubscriptionStatus {
  /// 14-day free trial, no card taken.
  TRIALING
  ACTIVE
  /// A payment failed. Still fully working — see the grace period.
  PAST_DUE
  /// Trial ended or grace expired without payment. Read-only, never deleted.
  SUSPENDED
  CANCELED
}

enum MembershipRole {
  OWNER
  ADMIN
  INSTRUCTOR
  FRONT_DESK
}

model Organization {
  id       String @id @default(uuid()) @db.Uuid
  name     String
  slug     String @unique
  /// Default display timezone. Individual locations may differ — a studio
  /// running mobile events across a state line is a real case.
  timezone String @default("America/New_York")
  currency String @default("USD")

  // --- Our own subscription ----------------------------------------------
  // Distinct from Stripe Connect below: this is what the STUDIO pays US.
  // Two different Stripe relationships on one row, which is exactly why the
  // field names spell out which is which.
  plan               Plan               @default(SOLO)
  subscriptionStatus SubscriptionStatus @default(TRIALING)

  /// 14 days, no card. The clock starts at signup, not at first login.
  trialEndsAt DateTime? @map("trial_ends_at") @db.Timestamptz(3)

  billingCustomerId     String?   @unique @map("billing_customer_id")
  billingSubscriptionId String?   @unique @map("billing_subscription_id")
  currentPeriodEnd      DateTime? @map("current_period_end") @db.Timestamptz(3)

  /**
   * When a failed payment stops being a warning and starts being a block.
   * Set on the first failure; cleared the moment payment succeeds.
   */
  gracePeriodEndsAt DateTime? @map("grace_period_ends_at") @db.Timestamptz(3)

  /**
   * Set when an OPERATOR suspended this studio, as distinct from billing
   * suspending it.
   *
   * Both reasons write the same `SUSPENDED` status, and billing clears that
   * status on a successful payment — so without this column a suspension applied
   * for abuse is silently reverted by the studio's next invoice, and nobody can
   * tell afterwards which reason had set it. Every billing path that would clear
   * SUSPENDED checks this first; see `platformSuspensionHolds` in
   * billing.service.
   */
  suspendedByPlatformAt DateTime? @map("suspended_by_platform_at") @db.Timestamptz(3)
  /// Operator-facing only. Never shown to the studio.
  suspendedReason       String?   @map("suspended_reason")

  /**
   * Set when a studio is on a plan it is not paying for.
   *
   * Comping deliberately does NOT cancel the Stripe subscription, so a comped
   * studio can have `subscriptionStatus = ACTIVE` here while Stripe keeps
   * charging their card. The divergence is intended; being unable to see it is
   * not, which is why this is a stored fact rather than something inferred. The
   * platform studio detail response reports the conflict explicitly.
   */
  compedAt DateTime? @map("comped_at") @db.Timestamptz(3)

  /// Which setup steps the studio has finished. Drives the wizard.
  onboardingSteps  Json?     @map("onboarding_steps")
  onboardingDoneAt DateTime? @map("onboarding_done_at") @db.Timestamptz(3)

  // --- Studio branding ---------------------------------------------------
  //
  // A studio's accent, and nothing else. These two columns feed an override
  // LAYER over the shared design tokens — see src/lib/brand.ts. They can move
  // --clay, --clay-dk, --clay-lt and --clay-text; they can never move --ink,
  // --bg, --card, --line or any scale, so no theme can make a studio's own
  // dashboard unreadable.

  /// Id of a curated preset from BRAND_PRESETS. Defaults to the clay values the
  /// product already shipped, so an untouched studio looks exactly as before.
  /// An unknown id resolves back to clay rather than failing: a theme is
  /// decoration and must never be able to take a dashboard down.
  brandPreset String @default("indigo") @map("brand_preset")

  /// An owner-supplied accent, which WINS over brandPreset when set.
  ///
  /// Stored as the hex the owner chose, not as the derived palette. Derivation
  /// enforces WCAG AA and may move the value; keeping the request means a later
  /// change to the derivation rules reaches studios that already chose a colour,
  /// instead of freezing them against whatever the rules were on the day.
  brandAccent String? @map("brand_accent")

  // --- Studio storefront copy -------------------------------------------
  //
  // Fields the studio owner writes and their customers read on the public
  // booking page. Every one of these is optional and has a fallback in
  // renderBookingPage — an untouched studio still gets a working page, just a
  // generic one. Bounds mirror the CHECK constraints in the migration so a
  // value the database would reject fails validation with a readable message
  // rather than a 500.

  /// One-line subhead under the studio's name. Falls back to a generic
  /// prompt when unset.
  tagline String? @map("tagline")

  /// A paragraph or two shown below the class list. Plain text; HTML is
  /// escaped on render, so a studio pasting bold from a Word doc gets no
  /// formatting rather than a broken page.
  about String? @map("about")

  /// Surfaced in the page footer and when online bookings are switched off,
  /// so somebody who lands on the page still has a way to reach the studio.
  contactEmail String? @map("contact_email")
  contactPhone String? @map("contact_phone")

  /// Overrides the auto-generated <title> and meta description. Left null,
  /// the page falls back to "Book a class at {name}" and a description
  /// composed from the first few service names, which is what shipped in A0.
  seoTitle       String? @map("seo_title")
  seoDescription String? @map("seo_description")

  // --- Studio policy -----------------------------------------------------
  //
  // These exist as SETTINGS rather than as code because nobody has yet asked
  // three ceramics studios how they actually run. Every default below is a
  // considered guess, not an observed fact, and each is the kind of thing a
  // studio will have a firm and different opinion about. Keeping them in data
  // means changing one's mind is an UPDATE, not a migration plus a rewrite.

  /// Whether missing a class earns anything at all. Off by default: a studio
  /// that has never offered make-up classes should not start silently.
  makeUpCreditsEnabled Boolean @default(false) @map("make_up_credits_enabled")
  /// Days before an unused credit lapses. Zero means never.
  makeUpCreditDays Int @default(90) @map("make_up_credit_days")
  /**
   * Whether a credit requires warning the studio in advance.
   *
   * Defaults to true, and this is the guess I am least sure of. It rewards the
   * student who texts "can't make Tuesday" over the one who simply does not
   * appear, which is the behaviour a studio wants — but a studio that finds it
   * harsh will turn it off, and that is a one-field change.
   */
  makeUpRequiresNotice Boolean @default(true) @map("make_up_requires_notice")
  makeUpNoticeHours    Int     @default(24) @map("make_up_notice_hours")
  /// Whether a credit can be spent on any class, or only within its own cohort.
  makeUpCrossCohort    Boolean @default(true) @map("make_up_cross_cohort")

  /// Days a finished piece is held before the studio may dispose of it. The
  /// pickup reminder and the "uncollected" report both read this.
  pieceHoldDays Int @default(30) @map("piece_hold_days")

  /**
   * Where this studio came from — the one marketing number that matters.
   *
   * First-touch, captured client-side and passed through at signup. No
   * cookies and no cross-site identifier: for a self-serve product the
   * question is "which page produced signups", which needs an aggregate, not
   * a profile of a person.
   */
  signupSource   String? @map("signup_source")
  signupReferrer String? @map("signup_referrer")
  signupLanding  String? @map("signup_landing")

  // --- Stripe Connect ----------------------------------------------------
  // The studio is paid DIRECTLY. We are a platform, never the merchant of
  // record: their money never touches our balance, which keeps us out of
  // money-transmission territory and means a dispute is theirs to answer.
  stripeAccountId     String?   @unique @map("stripe_account_id")
  /// Stripe's own verdict, mirrored from the account.updated webhook. An
  /// account can exist and still be unable to take money.
  stripeChargesEnabled Boolean  @default(false) @map("stripe_charges_enabled")
  stripePayoutsEnabled Boolean  @default(false) @map("stripe_payouts_enabled")
  stripeOnboardedAt    DateTime? @map("stripe_onboarded_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  memberships          Membership[]
  serviceCategories    ServiceCategory[]
  serviceTypes         ServiceType[]
  staff                Staff[]
  customers            Customer[]
  locations            Location[]
  resources            Resource[]
  resourceAllocations  ResourceAllocation[]
  availabilityRules    AvailabilityRule[]
  availabilityOverride AvailabilityOverride[]
  busyBlocks           BusyBlock[]
  courseSeries         CourseSeries[]
  enrollments          Enrollment[]
  classCredits         ClassCredit[]
  classPacks           ClassPack[]
  packPurchases        ClassPackPurchase[]
  pieces               Piece[]
  firings              Firing[]
  waitlistEntries      WaitlistEntry[]
  sessions             Session[]
  bookings             Booking[]
  bookingHolds         BookingHold[]
  staffTimeBlocks      StaffTimeBlock[]
  idempotencyKeys      IdempotencyKey[]
  cancellationPolicies CancellationPolicy[]
  payments             Payment[]
  webhookEvents        WebhookEvent[]
  notifications        Notification[]
  notificationTemplates NotificationTemplate[]
  calendarConnections  CalendarConnection[]
  supportSessions      SupportSession[]
  invitations          Invitation[]

  @@map("organizations")
}

model User {
  id           String  @id @default(uuid()) @db.Uuid
  /// Global unique: one human, one login, potentially many organizations.
  /// Stored lowercased — addresses are compared case-insensitively.
  email        String  @unique
  passwordHash String? @map("password_hash")
  name         String

  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(3)

  /**
   * Set when the platform disables the account (S8).
   *
   * A timestamp rather than an `isActive` boolean, for the same reason
   * `revokedAt` and `endedAt` are timestamps elsewhere here: "when" is a
   * question somebody will ask, and a boolean has already thrown the answer
   * away by the time they do.
   *
   * Disabling REVOKES every refresh token as well as setting this. Without
   * that the account keeps working until each one expires — the access token
   * is stateless and short-lived, but a refresh token is fourteen days, and an
   * account you disabled that keeps refreshing itself is not disabled.
   */
  disabledAt     DateTime? @map("disabled_at") @db.Timestamptz(3)
  /// Operator-facing only. Never shown to the user it describes.
  disabledReason String?   @map("disabled_reason")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  memberships        Membership[]
  staff              Staff[]
  refreshTokens      RefreshToken[]
  verificationTokens VerificationToken[]
  platformAdmin      PlatformAdmin[]
  platformGrants     PlatformAdmin[] @relation("PlatformAdminGrantedBy")
  supportSessions    SupportSession[]
  invitationsSent     Invitation[] @relation("InvitationInvitedBy")
  invitationsAccepted Invitation[] @relation("InvitationAcceptedBy")

  @@map("users")
}

/// Platform-level (Artweel) authority. NOT a studio role.
///
/// `MembershipRole` answers "what may this person do inside that studio", and
/// platform authority is a different question with a different blast radius, so
/// it lives in a different table rather than as a fifth value on that enum.
///
/// A table rather than a boolean on `users` because "who has god mode" is a
/// question that deserves an answer with history: a revoked row stays, so the
/// grant and the removal are both recoverable facts rather than a flag that was
/// once true and now is not.
///
/// Deliberately NOT reachable from the HTTP surface. The first grant has to come
/// from somewhere, and an endpoint that mints platform admins is a permanent
/// privilege-escalation route sitting in the table waiting to be found — so
/// granting is a CLI script that requires shell access on the box
/// (`npm run platform:grant`).
model PlatformAdmin {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid

  /// Null for the bootstrap grant — there was nobody to grant it.
  grantedBy String?  @map("granted_by") @db.Uuid
  grantedAt DateTime @default(now()) @map("granted_at") @db.Timestamptz(3)

  /// Set rather than deleted, so losing access is as recorded as gaining it.
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)

  /// Why this person has it. Free text, for the human reading the table later.
  note String?

  user    User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  grantor User? @relation("PlatformAdminGrantedBy", fields: [grantedBy], references: [id], onDelete: SetNull)


  /// "One LIVE grant per human, keep every revoked one" is enforced by a PARTIAL
  /// unique index that Prisma cannot express here, so the migration creates it
  /// by hand:
  ///
  ///   CREATE UNIQUE INDEX platform_admins_user_id_live_key
  ///     ON platform_admins(user_id) WHERE revoked_at IS NULL;
  ///
  /// `@@unique([userId, revokedAt])` looks like it would do the job and does
  /// not: Postgres treats NULLs as distinct in a unique index, so every live
  /// grant carries revoked_at = NULL and the constraint would permit any number
  /// of them — the exact rows it is supposed to forbid.
  ///
  /// BEWARE when next running `prisma migrate dev`. Because the index cannot be
  /// expressed here, Prisma does not know it should exist, and a generated
  /// migration may quietly include a DROP for it. `migrate diff` reports "no
  /// difference" today, so this will not announce itself. If a generated
  /// migration mentions platform_admins_user_id_live_key, delete that statement.
  /// `tests/platform/gate.test.ts` asserts the constraint by attempting a direct
  /// double-insert, so losing it fails the suite rather than going unnoticed.
  @@index([userId])
  @@map("platform_admins")
}

/// One row per background worker, stamped on every tick.
///
/// Exists because of C2.1: three sweeps were written, tested, and called by
/// nothing outside the test suite for two days, while every health check stayed
/// green. A queue that silently does nothing looks exactly like a quiet queue,
/// and "the route returns 200" cannot tell them apart.
///
/// Note the contrast with [PlatformAuditLog]: the audit row must be atomic with
/// the action it records, and a failure to write it rolls the action back. This
/// is the opposite — a heartbeat is observability, so a failure to stamp it must
/// never stop the work. See `recordWorkerRun`.
model WorkerHeartbeat {
  /// The worker's own name. One row per worker, upserted forever, never grows.
  name String @id

  lastStartedAt  DateTime? @map("last_started_at") @db.Timestamptz(3)
  lastFinishedAt DateTime? @map("last_finished_at") @db.Timestamptz(3)

  /// Retained after a later success, so a fault that has since cleared is still
  /// visible rather than erased by the next quiet tick.
  lastError   String?   @map("last_error")
  lastErrorAt DateTime? @map("last_error_at") @db.Timestamptz(3)

  runs     Int @default(0)
  failures Int @default(0)

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("worker_heartbeats")
}

/// Every platform action, append-only.
///
/// This is the record that answers "what did that account touch?" after a
/// phished password — which, for an account with cross-tenant write over every
/// studio's customer PII, is the question that decides whether an incident is
/// recoverable or terminal. It is written in the SAME TRANSACTION as the action
/// it describes; see `withAudit` for why that is not optional.
///
/// Distinct from application logs (pino → stdout), which are ops telemetry and
/// belong in a log service. This is product data: queryable, retained, and shown
/// to the operator.
///
/// NO FOREIGN KEYS, deliberately — see the field notes below. An audit row must
/// outlive the things it refers to, and a FK's job is to stop exactly that.
model PlatformAuditLog {
  id String @id @default(uuid()) @db.Uuid

  /**
   * Who did it. No FK and no relation, plus a denormalised copy of the address.
   *
   * A FK with ON DELETE SET NULL would keep the row and erase the actor, which
   * is the one field the row exists for. A FK with CASCADE would delete the
   * evidence along with the account. Both are worse than no constraint. The
   * email is snapshotted at write time so the record stays readable by a human
   * years later, when the user row may be gone and a bare uuid means nothing.
   */
  actorUserId String @map("actor_user_id") @db.Uuid
  actorEmail  String @map("actor_email")

  /// Dotted and past-tense-free, e.g. `organization.suspend`, `trial.extend`.
  action String

  /// What was acted on. `targetId` is text, not uuid: not every target is a row.
  targetType String  @map("target_type")
  targetId   String? @map("target_id")

  /**
   * Which studio this was done to, if any. No FK for the same reason as the
   * actor: S11 contemplates archiving and purging organizations, and "everything
   * ever done to that studio" must remain answerable afterwards — especially
   * then, since that is when someone asks.
   */
  organizationId String? @map("organization_id") @db.Uuid

  /// Why. Required by the routes that take one; the log is worth far less
  /// without it, because "who" and "what" are usually the easy parts.
  reason String?

  /// Before/after, and anything else the action wants to preserve.
  metadata Json?

  ip        String?
  userAgent String? @map("user_agent")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  /// The two questions actually asked: everything done to one studio, and
  /// everything done by one operator — both newest first.
  @@index([organizationId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([createdAt])
  @@map("platform_audit_log")
}

/// A refresh token, stored only as a hash.
///
/// A leaked database must not yield usable sessions, so the raw token is
/// returned to the client once and never persisted. Rotation is mandatory:
/// every refresh issues a new token and revokes the old one.
///
/// `familyId` chains a rotation lineage together, which is what makes theft
/// detectable. If a token that was already rotated away is presented again,
/// either the legitimate client replayed it or an attacker stole it — and we
/// cannot tell which, so the entire family is revoked and the human logs in
/// again.
model RefreshToken {
  id        String @id @default(uuid()) @db.Uuid
  userId    String @map("user_id") @db.Uuid
  /// SHA-256 of the raw token. Not a password hash: the token is already
  /// 32 bytes of entropy, so key stretching buys nothing and costs latency.
  tokenHash String @unique @map("token_hash")
  familyId  String @map("family_id") @db.Uuid

  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)

  userAgent String? @map("user_agent")
  ip        String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([familyId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

enum VerificationPurpose {
  EMAIL_VERIFY
  PASSWORD_RESET
}

/// Single-use, short-lived tokens for email verification and password reset.
/// Hashed for the same reason as refresh tokens, and marked used rather than
/// deleted so a replay is distinguishable from an unknown token.
model VerificationToken {
  id        String              @id @default(uuid()) @db.Uuid
  userId    String              @map("user_id") @db.Uuid
  tokenHash String              @unique @map("token_hash")
  purpose   VerificationPurpose

  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@index([expiresAt])
  @@map("verification_tokens")
}

model Membership {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  userId         String         @map("user_id") @db.Uuid
  role           MembershipRole @default(INSTRUCTOR)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("memberships")
}

// ===========================================================================
// CATALOG
// ===========================================================================

enum BookingMode {
  /// Staff-availability driven. Capacity is usually 1. A private lesson.
  APPOINTMENT
  /// Seat-based on a concrete session. Capacity is the seat count.
  EVENT
  /// A multi-session course booked and paid for once.
  COURSE_SERIES
}

enum StaffPreference {
  MANUAL
  LEAST_BUSY
  MOST_BUSY
  ROUND_ROBIN
}

model ServiceCategory {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  name           String
  sortOrder      Int    @default(0) @map("sort_order")

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  serviceTypes ServiceType[]

  @@unique([organizationId, name])
  @@map("service_categories")
}

model ServiceType {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  categoryId     String?      @map("category_id") @db.Uuid
  name           String
  slug           String
  description    String?
  bookingMode    BookingMode  @default(APPOINTMENT) @map("booking_mode")

  durationMinutes Int @map("duration_minutes")

  /// Per-service, NOT a global setting. The plugin had one global slot_length,
  /// which makes a 180-minute wheel class and a 30-minute consult impossible
  /// to offer side by side.
  slotGranularityMinutes Int @default(15) @map("slot_granularity_minutes")

  capacityMin Int @default(1) @map("capacity_min")
  capacityMax Int @default(1) @map("capacity_max")

  priceCents   Int    @default(0) @map("price_cents")
  depositType  String @default("none") @map("deposit_type") // none | percent | fixed
  depositValue Int    @default(0) @map("deposit_value")

  paddingBeforeMinutes Int @default(0) @map("padding_before_minutes")
  paddingAfterMinutes  Int @default(0) @map("padding_after_minutes")

  /// How far ahead a customer must book, and how far out they may book.
  minNoticeMinutes Int @default(0) @map("min_notice_minutes")
  maxHorizonDays   Int @default(120) @map("max_horizon_days")

  staffPreference StaffPreference @default(MANUAL) @map("staff_preference")

  skillLevel               String? @map("skill_level")
  prerequisiteServiceTypeId String? @map("prerequisite_service_type_id") @db.Uuid

  /// G3 — what a customer needs to know BEFORE they book.
  ///
  /// Both plain text, and `highlights` is one bullet per line rather than a
  /// text[] or a Json array. There is no array column anywhere in this schema,
  /// and `organizations.about` already establishes the idiom: owner-authored
  /// prose stored as text and split in the renderer. A line is also the
  /// easiest thing for an owner to type into a textarea, which is what decides
  /// whether these ever get filled in.
  highlights       String? @db.Text
  preparationNotes String? @map("preparation_notes") @db.Text

  cancellationPolicyId String? @map("cancellation_policy_id") @db.Uuid

  color    String  @default("#A6522C")
  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category           ServiceCategory?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  cancellationPolicy CancellationPolicy? @relation(fields: [cancellationPolicyId], references: [id], onDelete: SetNull)

  staffServices    StaffService[]
  serviceLocations ServiceLocation[]
  serviceResources ServiceResource[]
  courseSeries     CourseSeries[]
  classPacks       ClassPack[]
  sessions         Session[]
  bookings         Booking[]

  @@unique([organizationId, slug])
  @@index([organizationId, isActive])
  @@map("service_types")
}

/// Cancellation and refund terms, stored as DATA rather than expressed in code.
///
/// Every studio wants different terms, and the terms change seasonally. A
/// policy encoded in application logic means a deploy every time a studio
/// changes its mind — which for a self-serve product means a support ticket
/// nobody is there to answer.
///
/// `tiers` is an ordered array, most generous first:
///   [{ hoursBefore: 48, refundPercent: 100 },
///    { hoursBefore: 24, refundPercent: 50, creditPercent: 50 },
///    { hoursBefore: 0,  refundPercent: 0,  creditPercent: 0  }]
///
/// The first tier whose `hoursBefore` is met by the actual notice wins.
model CancellationPolicy {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  name           String
  /// Applied to services that name no policy of their own. A partial unique
  /// index in the migration enforces at most one default per organization.
  isDefault      Boolean @default(false) @map("is_default")

  tiers Json

  noShowFeeCents        Int     @default(0) @map("no_show_fee_cents")
  allowReschedule       Boolean @default(true) @map("allow_reschedule")
  rescheduleCutoffHours Int     @default(24) @map("reschedule_cutoff_hours")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  serviceTypes ServiceType[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("cancellation_policies")
}

// ===========================================================================
// PEOPLE
// ===========================================================================

model Staff {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  userId         String? @map("user_id") @db.Uuid
  name           String
  email          String
  phone          String?
  bio            String?
  photoUrl       String? @map("photo_url")
  /// Authoritative for this person's working hours. Actually consulted by the
  /// availability engine — the plugin stored a timezone and never used it.
  timezone       String  @default("America/New_York")
  color          String  @default("#A6522C")
  isPublic       Boolean @default(true) @map("is_public")
  isActive       Boolean @default(true) @map("is_active")

  /// 0 = unlimited.
  maxBookingsPerDay Int @default(0) @map("max_bookings_per_day")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  staffServices        StaffService[]
  staffLocations       StaffLocation[]
  availabilityRules    AvailabilityRule[]
  availabilityOverride AvailabilityOverride[]
  busyBlocks           BusyBlock[]
  sessions             Session[]
  bookings             Booking[]
  courseSeries         CourseSeries[]
  staffTimeBlocks      StaffTimeBlock[]
  calendarConnection   CalendarConnection?

  @@unique([organizationId, email])
  @@index([organizationId, isActive])
  @@map("staff")
}

model StaffService {
  id                 String @id @default(uuid()) @db.Uuid
  staffId            String @map("staff_id") @db.Uuid
  serviceTypeId      String @map("service_type_id") @db.Uuid
  priceOverrideCents Int?   @map("price_override_cents")

  staff       Staff       @relation(fields: [staffId], references: [id], onDelete: Cascade)
  serviceType ServiceType @relation(fields: [serviceTypeId], references: [id], onDelete: Cascade)

  @@unique([staffId, serviceTypeId])
  @@index([serviceTypeId])
  @@map("staff_services")
}

model Customer {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  name           String
  email          String
  phone          String?
  notes          String?
  timezone       String?

  /// TCPA: SMS consent must be recorded, timestamped and revocable.
  smsConsentAt       DateTime? @map("sms_consent_at") @db.Timestamptz(3)
  marketingConsentAt DateTime? @map("marketing_consent_at") @db.Timestamptz(3)
  /// Set when the customer replies STOP. Opt-out ALWAYS wins over consent —
  /// a later booking form tick must not silently resubscribe them.
  smsOptedOutAt      DateTime? @map("sms_opted_out_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  bookings      Booking[]
  bookingHolds  BookingHold[]
  enrollments   Enrollment[]
  classCredits    ClassCredit[]
  packPurchases   ClassPackPurchase[]
  pieces          Piece[]
  waitlistEntries WaitlistEntry[]

  /// Scoped per organization. The plugin deduped on `email OR phone` globally,
  /// which merges two family members who share a phone.
  @@unique([organizationId, email])
  @@index([organizationId, phone])
  @@map("customers")
}

// ===========================================================================
// PLACES
// ===========================================================================

enum LocationType {
  /// The studio. Customers come here.
  FIXED
  /// A region the studio travels to. Radius or polygon.
  SERVICE_AREA
  /// The customer supplies the venue; address captured at booking time.
  CUSTOMER_SUPPLIED
}

model Location {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  name           String
  locationType   LocationType @default(FIXED) @map("location_type")

  address String?
  /// Finally used, rather than merely present as they were in the plugin.
  lat     Float?
  lng     Float?
  /// Locations carry their own zone: a mobile studio crossing a state line
  /// genuinely operates in two.
  timezone String @default("America/New_York")

  // --- SERVICE_AREA only -------------------------------------------------
  radiusMeters Int? @map("radius_meters")
  /// PostGIS polygon for irregular coverage. Prisma cannot type this, so it
  /// is read and written through raw SQL.
  boundary     Unsupported("geography(Polygon, 4326)")?

  /// [{ maxKm, feeCents, minSpendCents }] — travel pricing by distance band.
  travelFeeBands Json? @map("travel_fee_bands")

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  staffLocations      StaffLocation[]
  serviceLocations    ServiceLocation[]
  resources           Resource[]
  availabilityRules   AvailabilityRule[]
  sessions            Session[]
  bookings            Booking[]
  courseSeries        CourseSeries[]

  @@index([organizationId, isActive])
  @@map("locations")
}

model StaffLocation {
  id         String @id @default(uuid()) @db.Uuid
  staffId    String @map("staff_id") @db.Uuid
  locationId String @map("location_id") @db.Uuid

  staff    Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([staffId, locationId])
  @@map("staff_locations")
}

model ServiceLocation {
  id            String @id @default(uuid()) @db.Uuid
  serviceTypeId String @map("service_type_id") @db.Uuid
  locationId    String @map("location_id") @db.Uuid

  serviceType ServiceType @relation(fields: [serviceTypeId], references: [id], onDelete: Cascade)
  location    Location    @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([serviceTypeId, locationId])
  @@map("service_locations")
}

// ===========================================================================
// RESOURCES
//
// A pottery studio's capacity is not a number the owner types into a form.
// It is a physical fact: eight wheels means eight students. A kiln firing
// blocks a kiln for fourteen hours.
// ===========================================================================

enum ResourceType {
  WHEEL
  KILN
  SLAB_ROLLER
  KIT
  VEHICLE
  ROOM
  OTHER
}

model Resource {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  locationId     String?      @map("location_id") @db.Uuid
  name           String
  resourceType   ResourceType @default(OTHER) @map("resource_type")

  /// How many of this thing exist. Eight wheels is quantity 8.
  quantity Int @default(1)

  /// True when the resource cannot be shared for ANY overlapping period —
  /// a kiln, a room, a van. Denormalised onto resource_allocations so that a
  /// partial EXCLUDE constraint can enforce it in the database.
  ///
  /// False for counted resources (wheels), where overlap is legal up to
  /// `quantity` and correctness comes from a locked SUM instead.
  isExclusive Boolean @default(false) @map("is_exclusive")

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  location     Location?    @relation(fields: [locationId], references: [id], onDelete: SetNull)

  serviceResources ServiceResource[]
  allocations      ResourceAllocation[]
  firings          Firing[]

  @@index([organizationId, isActive])
  @@map("resources")
}

model ServiceResource {
  id               String @id @default(uuid()) @db.Uuid
  serviceTypeId    String @map("service_type_id") @db.Uuid
  resourceId       String @map("resource_id") @db.Uuid
  /// Per seat, not per booking: one wheel per student.
  quantityPerSeat  Int    @default(1) @map("quantity_per_seat")

  serviceType ServiceType @relation(fields: [serviceTypeId], references: [id], onDelete: Cascade)
  resource    Resource    @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@unique([serviceTypeId, resourceId])
  @@map("service_resources")
}

model ResourceAllocation {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  resourceId     String @map("resource_id") @db.Uuid

  /// Nullable: a kiln firing is an allocation with no booking behind it.
  bookingId String? @map("booking_id") @db.Uuid
  sessionId String? @map("session_id") @db.Uuid

  quantity Int @default(1)

  startsAt DateTime @map("starts_at") @db.Timestamptz(3)
  endsAt   DateTime @map("ends_at") @db.Timestamptz(3)

  /// Copied from resource.isExclusive at write time so the partial EXCLUDE
  /// constraint has a same-row predicate to test.
  exclusive Boolean @default(false)

  note String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  resource     Resource     @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  booking      Booking?     @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  session      Session?     @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([resourceId, startsAt, endsAt])
  @@index([organizationId])
  @@map("resource_allocations")
}

// ===========================================================================
// AVAILABILITY
//
// Three plugin tables (staff_schedule, staff_breaks, staff_days_off) collapse
// into rules + overrides. Recurrence is an RRULE evaluated in local time,
// never a pre-generated row per day that then drifts out of sync.
// ===========================================================================

enum AvailabilityRuleType {
  WORKING
  BREAK
}

enum OverrideType {
  DAY_OFF
  CUSTOM_HOURS
  EXTRA_HOURS
}

model AvailabilityRule {
  id             String               @id @default(uuid()) @db.Uuid
  organizationId String               @map("organization_id") @db.Uuid
  staffId        String               @map("staff_id") @db.Uuid
  locationId     String?              @map("location_id") @db.Uuid
  ruleType       AvailabilityRuleType @default(WORKING) @map("rule_type")

  /// iCal RRULE, e.g. FREQ=WEEKLY;BYDAY=TU,TH
  rrule String

  /// Wall-clock, local to `timezone`. Stored as minutes past local midnight
  /// rather than a TIME column: it makes DST arithmetic explicit instead of
  /// hiding it inside a type that has no zone.
  startMinute Int    @map("start_minute")
  endMinute   Int    @map("end_minute")
  timezone    String

  effectiveFrom  DateTime  @map("effective_from") @db.Timestamptz(3)
  effectiveUntil DateTime? @map("effective_until") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  staff        Staff        @relation(fields: [staffId], references: [id], onDelete: Cascade)
  location     Location?    @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@index([staffId, effectiveFrom])
  @@index([organizationId])
  @@map("availability_rules")
}

model AvailabilityOverride {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  staffId        String       @map("staff_id") @db.Uuid
  overrideType   OverrideType @map("override_type")

  /// Local calendar date the override applies to, as YYYY-MM-DD. A date has
  /// no instant until you know the zone, so it is stored as what it is.
  localDate String @map("local_date")

  startMinute Int? @map("start_minute")
  endMinute   Int? @map("end_minute")

  reason String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  staff        Staff        @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([staffId, localDate, overrideType])
  @@index([organizationId])
  @@map("availability_overrides")
}

model BusyBlock {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  staffId        String @map("staff_id") @db.Uuid

  externalSource String  @map("external_source") // google | outlook | apple
  externalId     String  @map("external_id")
  title          String?

  startsAt DateTime @map("starts_at") @db.Timestamptz(3)
  endsAt   DateTime @map("ends_at") @db.Timestamptz(3)

  syncedAt DateTime @default(now()) @map("synced_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  staff        Staff        @relation(fields: [staffId], references: [id], onDelete: Cascade)

  /// Deliberately NO exclusion constraint. External calendars legitimately
  /// contain overlapping events, and a sync must never fail because someone
  /// double-booked themselves in Google. These are advisory input to the
  /// availability engine, not commitments.
  @@unique([staffId, externalSource, externalId])
  @@index([staffId, startsAt, endsAt])
  @@map("busy_blocks")
}

// ===========================================================================
// SESSIONS & BOOKINGS
// ===========================================================================

enum SessionStatus {
  SCHEDULED
  CANCELLED
  COMPLETED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  ATTENDED
  NO_SHOW
  CANCELLED
}

enum CourseSeriesStatus {
  /// Created, sessions not yet generated or not yet on sale.
  DRAFT
  /// On sale. Only PUBLISHED cohorts are visible publicly or enrollable.
  PUBLISHED
  /// Called off. Sessions are cancelled and enrolments refunded manually.
  CANCELLED
}

/// A cohort: one run of a multi-week course.
///
/// "Beginner Wheel Throwing" is a ServiceType. "Beginner Wheel Throwing,
/// Fall 2026, Tuesdays 7pm" is a CourseSeries, and the six Tuesday evenings
/// are its Sessions. Running the same course twice means two rows here, which
/// is why cohort identity lives on this table rather than being inferred from
/// a date range over sessions.
model CourseSeries {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  serviceTypeId  String @map("service_type_id") @db.Uuid
  name           String
  cohortLabel    String? @map("cohort_label")
  description    String?
  sessionCount   Int    @map("session_count")
  priceCents     Int    @default(0) @map("price_cents")

  status CourseSeriesStatus @default(DRAFT)

  /// The cohort's wall-clock zone. Sessions are re-resolved against this per
  /// date, so a Tuesday 7pm course stays at 7pm across a DST boundary.
  timezone String

  /// Seat count applied to every generated session. A course has one roster,
  /// so per-session capacity variation would be meaningless.
  capacity Int @default(1)

  /// The cohort's default instructor and room, copied onto each session.
  staffId    String? @map("staff_id") @db.Uuid
  locationId String? @map("location_id") @db.Uuid

  /// After this instant the cohort stops accepting enrolments even if seats
  /// remain. Null means "until it starts".
  enrollmentClosesAt DateTime? @map("enrollment_closes_at") @db.Timestamptz(3)

  /**
   * Whether someone may join after the first session has run.
   *
   * Defaults to false, and that default is the domain talking rather than
   * caution: a six-week wheel course is cumulative — centring in week one,
   * trimming in week three — so week-four arrivals are a bad experience for
   * them and a drag on everyone else. Studios that run drop-in-shaped courses
   * can turn it on.
   */
  allowLateEnrollment Boolean @default(false) @map("allow_late_enrollment")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  serviceType  ServiceType  @relation(fields: [serviceTypeId], references: [id], onDelete: Cascade)
  staff        Staff?       @relation(fields: [staffId], references: [id], onDelete: SetNull)
  location     Location?    @relation(fields: [locationId], references: [id], onDelete: SetNull)
  sessions     Session[]
  enrollments  Enrollment[]
  bookingHolds BookingHold[]

  @@index([organizationId])
  @@index([organizationId, status])
  @@map("course_series")
}

enum EnrollmentStatus {
  ACTIVE
  CANCELLED
  COMPLETED
}

/**
 * One customer's place in one cohort.
 *
 * An enrolment is the thing sold, but it is NOT the thing scheduled. It fans
 * out into one Booking per session, and those bookings are ordinary bookings
 * in every respect.
 *
 * That fan-out is the central decision here, and it is deliberately the
 * boring one. Seat counting, cancellation, calendar sync, reminders and the
 * per-class roster are all already correct at Booking granularity. A parallel
 * "series booking" that occupied six sessions implicitly would force every one
 * of those subsystems to grow a second code path — and the week-three roster,
 * the single most-used screen in a studio, would stop being a plain query.
 * Six rows per enrolment is a very cheap price for that.
 *
 * The money lives here rather than on the bookings: the customer bought a
 * course, not six classes, and splitting the price across sessions would
 * invent per-week revenue that nobody agreed to.
 */
model Enrollment {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  courseSeriesId String @map("course_series_id") @db.Uuid
  customerId     String @map("customer_id") @db.Uuid

  seats  Int              @default(1)
  status EnrollmentStatus @default(ACTIVE)

  totalCents Int @default(0) @map("total_cents")

  /// 32 random bytes, same as Booking. A management link carries its own
  /// credential and must not be derivable from the customer's email.
  cancelToken Bytes  @unique @map("cancel_token")
  source      String @default("web")
  notes       String?

  /// Set when enrolment happened after the cohort's first session, which is
  /// only possible on a cohort that allows it. Recorded because it changes
  /// what the studio owes the student.
  joinedLate Boolean @default(false) @map("joined_late")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  courseSeries CourseSeries @relation(fields: [courseSeriesId], references: [id], onDelete: Cascade)
  customer     Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)

  bookings      Booking[]
  payments      Payment[]
  classCredits  ClassCredit[]

  @@index([organizationId])
  @@index([courseSeriesId])
  @@index([customerId])
  @@map("enrollments")
}

/// A concrete, bookable instance in time.
///
/// The plugin derived event sessions on the fly from a start time, a count
/// and a gap, on every single request. Making them real rows is what makes a
/// lockable seat counter, waitlists and per-session cancellation possible.
model Session {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  serviceTypeId  String  @map("service_type_id") @db.Uuid
  courseSeriesId String? @map("course_series_id") @db.Uuid
  /// "week 3 of 6"
  seriesIndex    Int?    @map("series_index")

  staffId    String? @map("staff_id") @db.Uuid
  locationId String? @map("location_id") @db.Uuid

  startsAt DateTime @map("starts_at") @db.Timestamptz(3)
  endsAt   DateTime @map("ends_at") @db.Timestamptz(3)

  /// The instant above is authoritative for ordering and comparison. These
  /// two preserve INTENT: "7pm local, in this zone". Without them a DST shift
  /// silently moves a recurring class by an hour.
  timezone       String
  localStartTime String @map("local_start_time") // "19:00"

  capacity Int @default(1)

  /// Authoritative reserved-seat count: confirmed bookings PLUS live holds.
  /// A CHECK constraint keeps it within [0, capacity], and every mutation
  /// happens under SELECT ... FOR UPDATE on this row.
  seatsTaken Int @default(0) @map("seats_taken")

  status SessionStatus @default(SCHEDULED)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  serviceType  ServiceType   @relation(fields: [serviceTypeId], references: [id], onDelete: Cascade)
  courseSeries CourseSeries? @relation(fields: [courseSeriesId], references: [id], onDelete: Cascade)
  staff        Staff?        @relation(fields: [staffId], references: [id], onDelete: SetNull)
  location     Location?     @relation(fields: [locationId], references: [id], onDelete: SetNull)

  bookings            Booking[]
  bookingHolds        BookingHold[]
  resourceAllocations ResourceAllocation[]
  staffTimeBlocks     StaffTimeBlock[]
  calendarEventLinks  CalendarEventLink[]
  pieces              Piece[]
  waitlistEntries     WaitlistEntry[]

  @@index([organizationId, startsAt])
  @@index([serviceTypeId, startsAt])
  @@index([courseSeriesId, seriesIndex])
  @@map("sessions")
}

enum WaitlistStatus {
  /// In the queue, nothing reserved.
  WAITING
  /// A seat is being held for them and the clock is running.
  OFFERED
  /// They took it. `bookingId` says what they got.
  CLAIMED
  /// The offer window ran out. The seat went to the next person.
  EXPIRED
  /// They withdrew, or the studio removed them.
  CANCELLED
}

/**
 * Somebody who wanted a place and could not have one.
 *
 * The one point in the product where demand arrives, is refused, and would
 * otherwise leave no trace. A studio whose Saturday class fills every week
 * cannot currently answer "how many people did I turn away", which is exactly
 * the number that justifies opening a second session.
 */
model WaitlistEntry {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  sessionId      String @map("session_id") @db.Uuid
  customerId     String @map("customer_id") @db.Uuid

  seats  Int            @default(1)
  status WaitlistStatus @default(WAITING)

  /**
   * Queue order, assigned on joining and never renumbered.
   *
   * Gaps are fine and expected — somebody withdrawing leaves a hole rather
   * than shuffling everyone up. Renumbering a queue under concurrent writes
   * is a lock-ordering problem nobody needs, and "you are third" only has to
   * be true relative to the others.
   */
  position Int

  /// The seat being held for them while they decide. Released on expiry.
  holdId String? @map("hold_id") @db.Uuid

  offeredAt DateTime? @map("offered_at") @db.Timestamptz(3)
  /// When the offer lapses and the seat passes to the next person.
  offerExpiresAt DateTime? @map("offer_expires_at") @db.Timestamptz(3)
  notifiedAt     DateTime? @map("notified_at") @db.Timestamptz(3)

  /// What they ended up with, once claimed.
  bookingId String? @unique @map("booking_id") @db.Uuid

  /// Their own credential for claiming, in a link. 32 random bytes, same as
  /// a booking's cancel token — there is no customer login to fall back on.
  claimToken Bytes @unique @map("claim_token")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  session      Session      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  customer     Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([sessionId, status, position])
  @@index([organizationId])
  @@index([offerExpiresAt, status])
  @@map("waitlist_entries")
}

enum ClassCreditStatus {
  AVAILABLE
  REDEEMED
  EXPIRED
  /// Revoked by the studio, or voided because the absence was reversed.
  CANCELLED
}

/// Where an entitlement came from. The redemption path does not care.
enum ClassCreditSource {
  /// Missed a class on a course.
  ABSENCE
  /// Bought as part of a class pack.
  PACK
  /// The studio squaring something up by hand.
  GRANT
}

/**
 * ONE seat, owed to a customer, redeemable against a class.
 *
 * The single entitlement currency in the system, deliberately. A missed course
 * session and a prepaid class pack produce exactly the same thing — a seat the
 * customer is owed — and the moment they are separate tables there are two
 * redemption paths, two double-spend guards, and a customer who cannot see one
 * balance. `source` records where it came from; nothing about spending it
 * cares.
 *
 * Modelled per-credit rather than as a counter because the questions a studio
 * asks are per-credit: when does this lapse, what did it come from, which
 * class was it spent on. A running total answers none of those and cannot
 * expire.
 *
 * ASSUMPTION, UNVALIDATED: a credit buys one seat in one class. A studio that
 * runs "three misses and you repeat the term" thinks in a different currency.
 *
 * For ABSENCE credits, one-per-absence is enforced by a partial unique index
 * on `source_booking_id` rather than left to code — that is what makes
 * issuance idempotent when a register is saved twice.
 */
model ClassCredit {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  customerId     String @map("customer_id") @db.Uuid

  source ClassCreditSource @default(ABSENCE)

  /// ABSENCE credits: where it came from. Both kept so a studio sees the story.
  enrollmentId    String? @map("enrollment_id") @db.Uuid
  sourceBookingId String? @map("source_booking_id") @db.Uuid

  /// PACK credits: which purchase minted it.
  packPurchaseId String? @map("pack_purchase_id") @db.Uuid

  status ClassCreditStatus @default(AVAILABLE)

  /// Null means it never lapses, matching `makeUpCreditDays = 0`.
  expiresAt DateTime? @map("expires_at") @db.Timestamptz(3)

  redeemedAt        DateTime? @map("redeemed_at") @db.Timestamptz(3)
  redeemedBookingId String?   @unique @map("redeemed_booking_id") @db.Uuid

  /// Why it was issued, in words, for the studio's own records.
  reason String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer           @relation(fields: [customerId], references: [id], onDelete: Cascade)
  enrollment   Enrollment?        @relation(fields: [enrollmentId], references: [id], onDelete: SetNull)
  packPurchase ClassPackPurchase? @relation(fields: [packPurchaseId], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@index([customerId, status])
  @@index([packPurchaseId])
  @@map("class_credits")
}

/**
 * What a studio sells: "ten classes for £400, valid six months".
 *
 * A product definition, not a purchase. Deactivating one must not disturb the
 * packs people already bought, which is why price and validity are COPIED onto
 * the purchase rather than read through — a studio raising its prices cannot
 * retroactively change what somebody already paid, and shortening validity
 * must not shorten a credit already in somebody's hands.
 */
model ClassPack {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  name        String
  description String?

  /// How many seats it is worth.
  creditCount Int @map("credit_count")
  priceCents  Int @map("price_cents")

  /// Days the credits stay usable. Zero means they never lapse.
  validityDays Int @default(365) @map("validity_days")

  /**
   * Optional restriction to one kind of class.
   *
   * A studio selling "ten wheel classes" does not want them spent on a
   * £200 mobile party. Null means any class.
   */
  serviceTypeId String? @map("service_type_id") @db.Uuid

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  serviceType  ServiceType? @relation(fields: [serviceTypeId], references: [id], onDelete: SetNull)

  purchases ClassPackPurchase[]

  @@index([organizationId, isActive])
  @@map("class_packs")
}

enum PackPurchaseStatus {
  /// Checkout started, money not confirmed. No credits exist yet.
  PENDING
  /// Paid, and its credits have been issued.
  ACTIVE
  /// Refunded or withdrawn; unspent credits cancelled with it.
  REFUNDED
}

/// Somebody bought a pack. Its credits hang off this row.
model ClassPackPurchase {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  classPackId    String @map("class_pack_id") @db.Uuid
  customerId     String @map("customer_id") @db.Uuid

  status PackPurchaseStatus @default(PENDING)

  /// Snapshotted from the pack at purchase, never read through. See ClassPack.
  creditCount   Int     @map("credit_count")
  pricePaidCents Int    @map("price_paid_cents")
  validityDays  Int     @map("validity_days")
  serviceTypeId String? @map("service_type_id") @db.Uuid

  /// Set when payment lands and the credits are minted.
  issuedAt  DateTime? @map("issued_at") @db.Timestamptz(3)
  expiresAt DateTime? @map("expires_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  classPack    ClassPack    @relation(fields: [classPackId], references: [id], onDelete: Restrict)
  customer     Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)

  credits  ClassCredit[]
  payments Payment[]

  @@index([organizationId, status])
  @@index([customerId])
  @@map("class_pack_purchases")
}

/**
 * The lifecycle a pot goes through.
 *
 * ASSUMPTION, UNVALIDATED: two firings, bisque then glaze, in that order. That
 * is the common studio path and matches the Phase 2 exit gate, but it is not
 * universal — single-fire, raku, and multiple glaze firings all exist. The
 * enum is ordered so that adding a state later is additive rather than a
 * renumbering.
 */
enum PieceStatus {
  /// Made, still drying. Cannot be fired yet.
  GREENWARE
  /// Dry and queued for its first firing.
  AWAITING_BISQUE
  /// In a kiln load that is firing now.
  BISQUE_FIRING
  /// First firing done, waiting to be glazed by its maker.
  BISQUED
  /// Glazed and queued for its second firing.
  AWAITING_GLAZE
  GLAZE_FIRING
  /// Finished and collectable. This is the state that texts the customer.
  FINISHED
  COLLECTED
  /// Lost — cracked in the kiln, dropped, or written off.
  BROKEN
}

/// A single piece of work, tracked from wet clay to the customer's hands.
model Piece {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  customerId     String @map("customer_id") @db.Uuid

  /// Which class it was made in, when that is known. Optional because a
  /// member throwing on open-studio time has no session.
  sessionId    String? @map("session_id") @db.Uuid
  enrollmentId String? @map("enrollment_id") @db.Uuid

  /**
   * What the studio writes on the bottom of the pot.
   *
   * Free text, not a generated code. Studios already have a system — initials,
   * a number, a coloured dot — and a product that insists on its own scheme
   * makes staff maintain two.
   */
  label       String
  description String?
  /// Where it physically is. The single most-asked question in a studio.
  shelfLocation String? @map("shelf_location")

  status PieceStatus @default(GREENWARE)

  /// Set when it reaches FINISHED; the hold period counts from here.
  readyAt     DateTime? @map("ready_at") @db.Timestamptz(3)
  collectedAt DateTime? @map("collected_at") @db.Timestamptz(3)
  /// Set once the "your piece is ready" message has been queued, so a second
  /// status write cannot text the customer twice.
  notifiedAt  DateTime? @map("notified_at") @db.Timestamptz(3)

  /// Which load it is in right now, if any.
  firingId String? @map("firing_id") @db.Uuid

  notes String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  session      Session?     @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  firing       Firing?      @relation(fields: [firingId], references: [id], onDelete: SetNull)

  events PieceEvent[]

  @@index([organizationId, status])
  @@index([customerId])
  @@index([firingId])
  @@map("pieces")
}

/**
 * Every status change, kept forever.
 *
 * "Where is my mug" is answerable from `pieces.status`. "You said it was ready
 * three weeks ago" is not, and that is the conversation a studio actually
 * needs the record for.
 */
model PieceEvent {
  id      String @id @default(uuid()) @db.Uuid
  pieceId String @map("piece_id") @db.Uuid

  fromStatus PieceStatus? @map("from_status")
  toStatus   PieceStatus  @map("to_status")
  note       String?
  /// The membership that made the change, where a person made it.
  actorUserId String? @map("actor_user_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  piece Piece @relation(fields: [pieceId], references: [id], onDelete: Cascade)

  @@index([pieceId, createdAt])
  @@map("piece_events")
}

enum FiringType {
  BISQUE
  GLAZE
}

enum FiringStatus {
  /// Booked into the kiln, not yet packed.
  SCHEDULED
  /// Being packed.
  LOADING
  FIRING
  COOLING
  COMPLETE
  CANCELLED
}

/**
 * A kiln load.
 *
 * The kiln itself is already an exclusive Resource from Phase 0, and a firing
 * takes a ResourceAllocation over its whole span — so two firings cannot claim
 * one kiln, and the EXCLUDE constraint enforces that rather than application
 * code. This is why kilns were modelled as exclusive resources long before
 * firings existed.
 *
 * The span covers COOLING as well as FIRING, deliberately: a kiln full of
 * cooling work is not available, and a studio that books over that opens it
 * early and cracks the load.
 */
model Firing {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  /// The kiln. An exclusive Resource.
  resourceId     String @map("resource_id") @db.Uuid

  firingType FiringType   @map("firing_type")
  status     FiringStatus @default(SCHEDULED)

  /// Includes cooling. See the note above.
  startsAt DateTime @map("starts_at") @db.Timestamptz(3)
  endsAt   DateTime @map("ends_at") @db.Timestamptz(3)

  /// Cone number as written on the schedule, e.g. "04" or "6". Text because
  /// "04" and "4" are different cones and both are valid.
  cone String?

  /// The allocation holding the kiln, so cancelling a firing can release it.
  resourceAllocationId String? @unique @map("resource_allocation_id") @db.Uuid

  notes String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  resource     Resource     @relation(fields: [resourceId], references: [id], onDelete: Restrict)

  pieces Piece[]

  @@index([organizationId, startsAt])
  @@index([resourceId, startsAt])
  @@map("firings")
}

model Booking {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  customerId     String @map("customer_id") @db.Uuid
  serviceTypeId  String @map("service_type_id") @db.Uuid

  /// EVENT / COURSE_SERIES bookings point at a session.
  sessionId String? @map("session_id") @db.Uuid
  /// APPOINTMENT bookings point at a staff member instead.
  staffId   String? @map("staff_id") @db.Uuid

  /// Set on the per-session bookings fanned out from a course enrolment.
  /// Null for a standalone class booking. Cancelling the enrolment cancels
  /// every booking carrying its id.
  enrollmentId String? @map("enrollment_id") @db.Uuid

  locationId String? @map("location_id") @db.Uuid
  /// Mobile bookings: the customer's address, geocoded at booking time.
  serviceAddress Json? @map("service_address")

  startsAt DateTime @map("starts_at") @db.Timestamptz(3)
  endsAt   DateTime @map("ends_at") @db.Timestamptz(3)
  timezone String

  seats Int @default(1)

  status BookingStatus @default(PENDING)

  travelFeeCents Int @default(0) @map("travel_fee_cents")
  totalCents     Int @default(0) @map("total_cents")

  /// 32 random bytes. The plugin used md5(booking_id + email), which is
  /// guessable by anyone who knows the customer's email address.
  cancelToken Bytes  @unique @map("cancel_token")

  /// G5 — the short handle a customer quotes on the phone.
  ///
  /// GENERATED ALWAYS in Postgres from this row's own id, so it is READ ONLY
  /// here and writing it raises. Not to be confused with cancelToken, which is
  /// the secret: this is the opposite, the part that is safe to print.
  reference String? @db.Text

  source      String @default("web")

  notes String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  serviceType  ServiceType  @relation(fields: [serviceTypeId], references: [id], onDelete: Cascade)
  session      Session?     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  staff        Staff?       @relation(fields: [staffId], references: [id], onDelete: SetNull)
  location     Location?    @relation(fields: [locationId], references: [id], onDelete: SetNull)
  enrollment   Enrollment?  @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  resourceAllocations ResourceAllocation[]
  staffTimeBlocks     StaffTimeBlock[]
  payments            Payment[]
  notifications       Notification[]
  calendarEventLinks  CalendarEventLink[]

  @@index([organizationId, startsAt])
  @@index([sessionId])
  @@index([enrollmentId])
  @@index([staffId, startsAt])
  @@index([customerId])
  @@map("bookings")
}

/// A seat reservation held while a customer is inside checkout.
///
/// Held seats are counted in sessions.seats_taken, so a popular class cannot
/// be sold twice during the payment round-trip. An expiry job releases
/// abandoned holds. The plugin had no equivalent: it created the booking
/// first and hoped payment followed.
model BookingHold {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  sessionId      String? @map("session_id") @db.Uuid
  staffId        String? @map("staff_id") @db.Uuid
  customerId     String? @map("customer_id") @db.Uuid

  /**
   * A hold on a whole cohort rather than one class.
   *
   * ONE row, holding seats in EVERY week of the course. Modelling it as N
   * per-session holds would mean the sweep could expire week three's hold
   * while weeks one and two stayed reserved, leaving a customer mid-payment
   * with a course they can no longer be enrolled on.
   *
   * Mutually exclusive with sessionId — enforced by a CHECK constraint.
   */
  courseSeriesId String? @map("course_series_id") @db.Uuid

  seats Int @default(1)

  startsAt DateTime @map("starts_at") @db.Timestamptz(3)
  endsAt   DateTime @map("ends_at") @db.Timestamptz(3)

  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  /// Set once the hold has been converted or released, so the expiry job is
  /// idempotent and a hold can never be released twice.
  releasedAt DateTime? @map("released_at") @db.Timestamptz(3)

  checkoutReference String? @map("checkout_reference")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  session      Session?      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  courseSeries CourseSeries? @relation(fields: [courseSeriesId], references: [id], onDelete: Cascade)
  customer     Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([expiresAt, releasedAt])
  @@index([sessionId])
  @@index([courseSeriesId])
  @@map("booking_holds")
}

/// The single authoritative record of when a staff member is committed.
///
/// Appointments and sessions BOTH write here. That is the point: Postgres
/// cannot enforce an exclusion constraint across two tables, so an instructor
/// with a 2pm private lesson and a 2pm group class would otherwise collide
/// undetected. One table, one EXCLUDE constraint, no possible overlap.
///
/// External calendar events deliberately do NOT live here — see BusyBlock.
model StaffTimeBlock {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  staffId        String @map("staff_id") @db.Uuid

  bookingId String? @map("booking_id") @db.Uuid
  sessionId String? @map("session_id") @db.Uuid

  /// Includes padding and, for mobile bookings, travel time. This is the
  /// span during which the instructor genuinely cannot do anything else.
  startsAt DateTime @map("starts_at") @db.Timestamptz(3)
  endsAt   DateTime @map("ends_at") @db.Timestamptz(3)

  /// Where the instructor physically is for this block.
  ///
  /// Denormalised from the location or the customer-supplied address rather
  /// than joined at query time: the availability engine needs the coordinates
  /// of every adjacent commitment to compute travel time, and a three-way
  /// join on the hot read path is exactly what the 200ms budget cannot afford.
  lat Float?
  lng Float?

  source String @default("booking") // booking | session | manual

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  staff        Staff        @relation(fields: [staffId], references: [id], onDelete: Cascade)
  booking      Booking?     @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  session      Session?     @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([staffId, startsAt, endsAt])
  @@index([organizationId])
  @@map("staff_time_blocks")
}

/// Daily page-view counts for the marketing site.
///
/// Deliberately an AGGREGATE with no user identifier, no cookie and no
/// fingerprint. That is not only a privacy position — it is also why the site
/// needs no consent banner, and a consent banner on a landing page measurably
/// costs signups. The number we act on is "which page produced trials", and
/// that comes from `organizations.signup_source`, not from following people.
model MarketingEvent {
  id   String @id @default(uuid()) @db.Uuid
  /// YYYY-MM-DD, UTC.
  day  String
  path String
  /// Referrer HOST only, never the full URL — a full referrer can carry a
  /// search query or a private page title.
  ///
  /// Empty string rather than NULL for "none", because Postgres treats NULLs
  /// as distinct in a unique index: with nullable columns here, every direct
  /// visit would insert a NEW row instead of incrementing the counter, and
  /// the table would grow one row per page view.
  referrerHost String @default("") @map("referrer_host")
  source       String @default("")

  views Int @default(0)

  @@unique([day, path, referrerHost, source])
  @@index([day])
  @@map("marketing_events")
}

enum CalendarConnectionStatus {
  ACTIVE
  /// The refresh token was rejected. Only the instructor can fix this by
  /// reconnecting, so it is a distinct state the UI must surface loudly.
  NEEDS_REAUTH
  DISABLED
}

/// One instructor's connected calendar.
///
/// Per staff member, not per studio: an instructor's availability is their
/// own calendar, and a freelancer teaching at three studios connects once per
/// studio because each studio only gets to see the busy times relevant to it.
model CalendarConnection {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  staffId        String @unique @map("staff_id") @db.Uuid

  provider String @default("google")
  /// The Google account that was connected, shown so an instructor can tell
  /// which of their logins is in use.
  accountEmail String? @map("account_email")
  calendarId   String  @default("primary") @map("calendar_id")

  /// AES-256-GCM ciphertext, never plaintext. See lib/crypto.ts.
  accessTokenEnc  String    @map("access_token_enc")
  refreshTokenEnc String?   @map("refresh_token_enc")
  tokenExpiresAt  DateTime? @map("token_expires_at") @db.Timestamptz(3)

  /// Google's incremental sync cursor. Absent means the next sync is a full one.
  syncToken String? @map("sync_token")

  /// Push notification channel. Google expires these after about a week, so
  /// they have to be renewed or inbound sync silently stops.
  channelId         String?   @unique @map("channel_id")
  channelResourceId String?   @map("channel_resource_id")
  channelExpiresAt  DateTime? @map("channel_expires_at") @db.Timestamptz(3)
  /// Verifies inbound push requests actually came from our own watch call.
  channelTokenEnc   String?   @map("channel_token_enc")

  status       CalendarConnectionStatus @default(ACTIVE)
  lastSyncedAt DateTime?                @map("last_synced_at") @db.Timestamptz(3)
  lastError    String?                  @map("last_error")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  staff        Staff        @relation(fields: [staffId], references: [id], onDelete: Cascade)

  eventLinks CalendarEventLink[]
  syncJobs   CalendarSyncJob[]

  @@index([organizationId])
  @@index([channelExpiresAt])
  @@map("calendar_connections")
}

/// Maps one of our bookings or sessions to the event we created for it.
///
/// This is the LOOP GUARD. Inbound sync must be able to recognise an event as
/// one we pushed ourselves — otherwise a class we wrote to the instructor's
/// calendar comes back as a busy block and makes its own slot unbookable. The
/// previous WordPress implementation hit exactly this and worked around it by
/// disabling calendar checks for events entirely.
model CalendarEventLink {
  id           String  @id @default(uuid()) @db.Uuid
  connectionId String  @map("connection_id") @db.Uuid
  bookingId    String? @map("booking_id") @db.Uuid
  sessionId    String? @map("session_id") @db.Uuid

  externalEventId String @map("external_event_id")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  connection CalendarConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  booking    Booking?           @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  session    Session?           @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, externalEventId])
  @@unique([connectionId, bookingId])
  @@unique([connectionId, sessionId])
  @@index([externalEventId])
  @@map("calendar_event_links")
}

enum CalendarSyncAction {
  UPSERT
  DELETE
}

/// Outbound calendar writes, queued.
///
/// Same reasoning as the notification outbox: a booking must not fail because
/// Google is slow, and a write must not be lost because the process died. Uses
/// the identical lease-claim pattern.
model CalendarSyncJob {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  connectionId   String @map("connection_id") @db.Uuid

  bookingId String? @map("booking_id") @db.Uuid
  sessionId String? @map("session_id") @db.Uuid

  action CalendarSyncAction

  payload Json

  status       NotificationStatus @default(PENDING)
  attempts     Int                @default(0)
  scheduledFor DateTime           @map("scheduled_for") @db.Timestamptz(3)
  lastError    String?            @map("last_error")

  /// Collapses repeated edits to the same booking into one pending write.
  dedupeKey String @unique @map("dedupe_key")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  connection CalendarConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([status, scheduledFor])
  @@map("calendar_sync_jobs")
}

enum NotificationChannel {
  EMAIL
  SMS
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  /// Deliberately not sent — no consent, opted out, or no address on file.
  SKIPPED
  /// Superseded before it went out, e.g. a reminder for a cancelled booking.
  CANCELLED
}

/// A transactional OUTBOX, not a log.
///
/// Rows are written when something happens and drained by a worker, rather
/// than sent inline. Sending inside the request would make a booking fail
/// because an email provider was slow, and would lose the message entirely if
/// the process died mid-send.
///
/// Workers claim rows with SELECT ... FOR UPDATE SKIP LOCKED, so several can
/// run without ever handing the same message to two of them.
/**
 * An invitation to join a studio (S9).
 *
 * Its own table rather than a `VerificationToken`, because that model hangs off
 * a `userId` and an invitee usually has no account yet. Creating a placeholder
 * User to hold the token was the alternative and is worse in two ways: it
 * leaves phantom rows for invitations nobody accepts, and `User.email` is
 * globally unique — so inviting somebody who already works at another studio
 * would collide with their real account.
 *
 * Modelling it properly also makes the questions an owner actually asks
 * answerable: who have I invited, who has not replied, and can I take it back.
 */
model Invitation {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  /// Stored as given, matched case-insensitively — see the partial unique
  /// index in the migration.
  email          String
  name           String
  /// Never OWNER. Enforced by a CHECK constraint as well as by zod: ownership
  /// is transferred between people who already have accounts, not handed to a
  /// stranger who has not clicked a link yet.
  role           MembershipRole

  /// 32 random bytes, stored hashed — the same shape as every other token in
  /// this codebase. The raw value exists only in the email.
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)

  invitedByUserId String    @map("invited_by_user_id") @db.Uuid
  acceptedAt      DateTime? @map("accepted_at") @db.Timestamptz(3)
  acceptedUserId  String?   @map("accepted_user_id") @db.Uuid
  /// Taken back before it was used. Kept rather than deleted: "we invited the
  /// wrong person and withdrew it" is a thing worth being able to show.
  revokedAt       DateTime? @map("revoked_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy    User         @relation("InvitationInvitedBy", fields: [invitedByUserId], references: [id], onDelete: Cascade)
  acceptedUser User?        @relation("InvitationAcceptedBy", fields: [acceptedUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([expiresAt])
  @@map("invitations")
}

/**
 * A platform operator looking inside one studio, for a bounded window.
 *
 * The row exists so the session is a THING rather than just a token in
 * somebody's clipboard: it can be listed, ended early, and answered for
 * afterwards. A JWT alone would be none of those — stateless means
 * unrevokable, and "we issued something 25 minutes ago" is not an answer to
 * "who was in my studio".
 *
 * `authenticate` reads this row on every request carrying a support token, so
 * ending a session takes effect immediately rather than at expiry.
 */
model SupportSession {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  /// The human at the keyboard — always a platform admin's user id, never the
  /// studio's. This is the field the audit log must never lose.
  actorUserId String @map("actor_user_id") @db.Uuid
  actorEmail  String @map("actor_email")

  /// Why. Required, minimum length enforced at the route: a reason that can be
  /// satisfied with "x" records only that somebody typed a character.
  reason String

  /// Defaults to true. A write-enabled session is the unusual one and has to be
  /// asked for explicitly.
  readOnly Boolean @default(true) @map("read_only")

  /// A hard wall. Nothing extends a session; you start another one, which is
  /// another row and another reason.
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  /// Set when an operator ends it early, or when it is revoked.
  endedAt   DateTime? @map("ended_at") @db.Timestamptz(3)

  /**
   * Reads are COUNTED, not logged.
   *
   * One audit row per read would bury the writes — a support session browsing a
   * calendar makes dozens of GETs and perhaps one change, and the log exists to
   * surface the change. So the reads accumulate here and the writes get their
   * own rows in platform_audit_log.
   */
  readCount  Int   @default(0) @map("read_count")
  writeCount Int   @default(0) @map("write_count")
  /// Distinct route paths touched, capped. Enough to answer "what did they
  /// look at" without reconstructing a session replay.
  endpoints  Json? @map("endpoints")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor        User         @relation(fields: [actorUserId], references: [id], onDelete: Cascade)

  /// The banner query: "is anyone in this studio right now".
  @@index([organizationId, expiresAt])
  @@index([actorUserId, createdAt])
  @@map("support_sessions")
}

model Notification {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  bookingId      String? @map("booking_id") @db.Uuid
  customerId     String? @map("customer_id") @db.Uuid

  channel     NotificationChannel
  templateKey String              @map("template_key")

  /// Email address or E.164 number, resolved at enqueue time so a later
  /// change to the customer record cannot redirect a queued message.
  destination String
  /// Everything the template needs. Snapshotted for the same reason.
  payload     Json

  status   NotificationStatus @default(PENDING)
  attempts Int                @default(0)

  /// When it may first be sent. Reminders are enqueued immediately and dated
  /// forward; retries push this out with exponential backoff.
  scheduledFor DateTime  @map("scheduled_for") @db.Timestamptz(3)
  sentAt       DateTime? @map("sent_at") @db.Timestamptz(3)

  providerMessageId String? @map("provider_message_id")
  lastError         String? @map("last_error")

  /// Makes enqueueing idempotent. "reminder-24h for booking X" can only ever
  /// exist once, however many times the code path runs.
  dedupeKey String @unique @map("dedupe_key")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  booking      Booking?     @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  /// The worker's claim query. Partial, so it stays proportional to the
  /// backlog rather than to every message ever sent.
  @@index([status, scheduledFor])
  @@index([bookingId])
  @@index([organizationId, createdAt])
  @@map("notifications")
}

/// Per-studio wording. Falls back to the built-in defaults when absent, so a
/// studio that never opens the settings page still sends sensible messages.
model NotificationTemplate {
  id             String              @id @default(uuid()) @db.Uuid
  organizationId String              @map("organization_id") @db.Uuid
  templateKey    String              @map("template_key")
  channel        NotificationChannel

  subject String?
  body    String

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, templateKey, channel])
  @@map("notification_templates")
}

enum PaymentKind {
  DEPOSIT
  BALANCE
  FULL
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

/// Money, kept in its own table rather than as columns on `bookings`.
///
/// The previous implementation stored payment_method, payment_status and
/// transaction_id directly on the booking, which cannot represent a deposit
/// plus a balance plus a partial refund — exactly what a £400 private party
/// needs. One booking has many payments; one payment has many refunds.
model Payment {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  bookingId      String? @map("booking_id") @db.Uuid
  /// Set while money is being collected but the booking does not exist yet.
  holdId         String? @map("hold_id") @db.Uuid
  /// A course is paid for once, as a course. The payment attaches here rather
  /// than to an arbitrarily chosen one of the six per-session bookings.
  enrollmentId   String? @map("enrollment_id") @db.Uuid
  /// A class pack is bought outright, against no booking at all.
  packPurchaseId String? @map("pack_purchase_id") @db.Uuid

  kind       PaymentKind
  amountCents Int        @map("amount_cents")
  currency   String      @default("USD")
  status     PaymentStatus @default(PENDING)

  provider                  String  @default("stripe")
  providerCheckoutSessionId String? @unique @map("provider_checkout_session_id")
  providerPaymentIntentId   String? @unique @map("provider_payment_intent_id")
  /// The connected account the money went to. Recorded so a later refund
  /// cannot be issued against the wrong studio.
  providerAccountId         String? @map("provider_account_id")

  refundedCents Int @default(0) @map("refunded_cents")

  failureReason String?   @map("failure_reason")
  succeededAt   DateTime? @map("succeeded_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  booking      Booking?     @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  enrollment   Enrollment?  @relation(fields: [enrollmentId], references: [id], onDelete: SetNull)
  packPurchase ClassPackPurchase? @relation(fields: [packPurchaseId], references: [id], onDelete: SetNull)
  refunds      Refund[]

  @@index([organizationId, createdAt])
  @@index([bookingId])
  @@index([enrollmentId])
  @@index([packPurchaseId])
  @@map("payments")
}

model Refund {
  id        String @id @default(uuid()) @db.Uuid
  paymentId String @map("payment_id") @db.Uuid

  amountCents Int     @map("amount_cents")
  /// Studio credit issued instead of cash, per the cancellation policy.
  creditCents Int     @default(0) @map("credit_cents")
  reason      String?

  providerRefundId String? @unique @map("provider_refund_id")
  status           String  @default("pending")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@map("refunds")
}

/// Every webhook Stripe has delivered, by its own event id.
///
/// Stripe retries until it gets a 2xx, and it does not promise to deliver
/// exactly once. Without this table a retried `checkout.session.completed`
/// creates a second booking and charges nobody for it. The unique constraint
/// on event_id is what makes processing idempotent.
model WebhookEvent {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String? @map("organization_id") @db.Uuid

  provider String @default("stripe")
  eventId  String @map("event_id")
  eventType String @map("event_type")

  processedAt DateTime? @map("processed_at") @db.Timestamptz(3)
  error       String?

  payload Json

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@unique([provider, eventId])
  @@index([eventType, processedAt])
  @@map("webhook_events")
}

/// Replay protection for mutating endpoints. A retried booking request must
/// return the original outcome, not create a second booking.
model IdempotencyKey {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  key            String
  endpoint       String
  requestHash    String @map("request_hash")

  responseStatus Int?  @map("response_status")
  responseBody   Json? @map("response_body")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, key])
  @@index([expiresAt])
  @@map("idempotency_keys")
}
