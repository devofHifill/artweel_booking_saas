# Copy to .env and fill in. Everything without a default is required.
#
# This file MUST stay in step with src/config/index.ts — the app validates its
# environment at startup and refuses to boot on anything missing, so a stale
# template turns a fresh clone into a guessing game.

NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# --- Database and cache ----------------------------------------------------
# Ports are shifted off the defaults in docker-compose.yml. 5433 is NOT safe on
# a machine with a native Postgres install: it wins the race for IPv4 localhost
# over Docker's port proxy, and clients silently connect to the wrong server.
# 5434 is not safe either — Windows re-rolls its reserved port blocks on every
# reboot and they can land on it. See the comment in docker-compose.yml.
DATABASE_URL="postgresql://booking:booking@localhost:15432/booking_dev?schema=public"
SHADOW_DATABASE_URL="postgresql://booking:booking@localhost:15432/booking_shadow?schema=public"
TEST_DATABASE_URL="postgresql://booking:booking@localhost:15432/booking_test?schema=public"

REDIS_URL="redis://localhost:6380"

# --- URLs ------------------------------------------------------------------
# APP_URL is the dashboard; PUBLIC_URL is where booking pages and the marketing
# site are served. They differ in development because the client runs on Vite.
APP_URL="http://localhost:5173"
PUBLIC_URL="http://localhost:4000"

# --- Auth ------------------------------------------------------------------
# Generate real values with: openssl rand -base64 48
# They MUST differ from each other — one secret for both means a leaked access
# token can be replayed as a refresh token.
JWT_ACCESS_SECRET="replace-me-at-least-32-characters-long-xxxxx"
JWT_REFRESH_SECRET="replace-me-different-from-access-secret-xxxxx"

ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
EMAIL_VERIFY_TTL_HOURS=48
PASSWORD_RESET_TTL_MINUTES=60

# scrypt cost exponent. 16 is roughly 67MB and ~150ms per hash, which is the
# point. The test suite overrides this down to 12 for speed.
PASSWORD_COST_EXPONENT=16

# --- Credential encryption -------------------------------------------------
# Encrypts third-party refresh tokens (Google Calendar) at rest.
# Generate with: openssl rand -base64 32   — must decode to exactly 32 bytes.
# Optional in development (a key is derived from JWT_ACCESS_SECRET); the app
# REFUSES TO BOOT in production without it.
CREDENTIAL_ENCRYPTION_KEY=""

# --- Booking behaviour -----------------------------------------------------
# How long seats stay reserved while a customer is inside checkout.
BOOKING_HOLD_TTL_MINUTES=10

# --- Payments (Stripe) -----------------------------------------------------
# Leave blank in development: the app falls back to an in-memory fake provider
# so the full checkout and refund flow works offline. Production refuses to
# boot without both — silently faking payments would confirm bookings nobody
# paid for.
STRIPE_SECRET_KEY=""
# Comma-separated, one signing secret per Stripe event destination. A Connect
# integration needs two — connected-accounts scope for checkout.session.* and
# account.updated, platform scope for our own subscription and invoice events —
# and Stripe issues a separate secret for each. A single value still works.
STRIPE_WEBHOOK_SECRET=""
# ISO country for new Connect accounts.
STRIPE_ACCOUNT_COUNTRY=US

# --- Email -----------------------------------------------------------------
# Blank means messages are logged instead of sent.
RESEND_API_KEY=""
EMAIL_FROM="bookings@example.test"

# --- SMS (Twilio) ----------------------------------------------------------
# Blank means messages are logged instead of sent.
#
# US SMS additionally needs an approved A2P 10DLC campaign. Without one,
# carriers FILTER the messages rather than rejecting them — they look sent and
# never arrive, which is the worst failure mode available.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# --- Reminders -------------------------------------------------------------
REMINDER_HOURS_AHEAD=24
SECOND_REMINDER_HOURS_AHEAD=2

# TCPA quiet hours, in the STUDIO's local time. An SMS that would land outside
# this window is deferred to the start of it. Confirmations are exempt — a
# customer who just booked is plainly awake.
SMS_QUIET_START_HOUR=8
SMS_QUIET_END_HOUR=21

NOTIFICATION_MAX_ATTEMPTS=6
# How long a worker's claim on a queued message lasts before it becomes due
# again. Covers a worker dying mid-send.
NOTIFICATION_LEASE_SECONDS=120

# --- Google Calendar -------------------------------------------------------
# Blank means calendar sync uses an in-memory fake provider.
# OAuth redirect URI to register: {PUBLIC_URL}/api/calendar/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
